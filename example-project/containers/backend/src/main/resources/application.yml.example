server:
  port: 8080
spring:
  application:
    name: consultation-backend
  datasource:
    url: jdbc:mysql://localhost:3306/consultation?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai
    username: root
    password: <your-mysql-password>
    driver-class-name: com.mysql.cj.jdbc.Driver
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true
mybatis-plus:
  mapper-locations: classpath:mapper/**/*.xml
  type-aliases-package: com.consultation.infrastructure.persistence.po
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: INPUT
jwt:
  secret: <your-jwt-secret>
  expiration: 86400000
# 手机号加密密钥（生产必须注入，禁止入仓）
phone:
  crypto:
    key: <your-phone-crypto-key>
sms:
  mock:
    # 固定验证码仅用于本地联调 / E2E；生产留空
    fixed-code: ${SMS_MOCK_FIXED_CODE:}
    expose-code: true
  code:
    ttl-seconds: 300
    resend-interval-seconds: 60
    max-failures: 5
consultant:
  displayable-ids: ${CONSULTANT_DISPLAYABLE_IDS:}
seed:
  admin:
    enabled: true
    phone: ${SEED_ADMIN_PHONE:13900000000}
    password: ${SEED_ADMIN_PASSWORD:<your-admin-password>}
business-rules:
  public-endpoints:
    - /api/v1/health
    - /api/v1/auth/**
